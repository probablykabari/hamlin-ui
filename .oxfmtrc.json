{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    "/.agents/",
    "/.claude/",
    "/.oxlintrc.json",
    "package.json",
    "/pnpm-workspace.yaml",
    "/skills-lock.json",
    "/styles/"
  ],
  "printWidth": 100,
  "overrides": [
    {
      "files": ["*.test.ts", "*.spec.ts"],
      "options": {
        "printWidth": 120
      }
    },
    {
      "files": ["*.md", "*.html"],
      "excludeFiles": [],
      "options": {
        "tabWidth": 4
      }
    }
  ]
}
