{
  "name": "hamlin-ui",
  "version": "1.0.0-rc.0",
  "description": "A design system for Unistyles",
  "keywords": [
    "design-system",
    "react-native",
    "react-native-web",
    "theme",
    "unistyles"
  ],
  "homepage": "https://github.com/probablykabari/hamlin-ui#readme",
  "bugs": "https://github.com/probablykabari/hamlin-ui/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/probablykabari/hamlin-ui.git",
    "directory": "packages/design-system"
  },
  "license": "MIT",
  "author": "Kabari Hendrick <hello@probablykabari.fyi>",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles": "./src/styles/index.ts"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/styles.mjs"
  ],
  "publishConfig": {
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./styles": {
        "types": "./dist/styles.d.mts",
        "default": "./dist/styles.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "tsdown"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "react-native": "^0.88.0",
    "react-native-nitro-modules": "0.37.1",
    "react-native-unistyles": "^3.6.0",
    "tsdown": "^0.23.4"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": ">=0.81.0",
    "react-native-unistyles": "^3.6.0"
  }
}
