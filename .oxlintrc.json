{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc"
  ],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "/.agents/",
    "/.claude/",
    "/.oxlintrc.json",
    "package.json",
    "skills-lock.json",
    "/pnpm-workspace.yaml",
    "/styles/"
  ],
  "rules": {},
  "env": {
    "builtin": true
  }
}